<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="connect"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_connect"
        android:shortcutShortLabel="@string/shortcut_connect"
        android:shortcutLongLabel="@string/shortcut_connect_long">
        <intent
            android:action="com.unigate.app.action.CONNECT"
            android:targetPackage="com.unigate.app"
            android:targetClass="com.unigate.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="disconnect"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_disconnect"
        android:shortcutShortLabel="@string/shortcut_disconnect"
        android:shortcutLongLabel="@string/shortcut_disconnect_long">
        <intent
            android:action="com.unigate.app.action.DISCONNECT"
            android:targetPackage="com.unigate.app"
            android:targetClass="com.unigate.app.MainActivity" />
    </shortcut>
</shortcuts>
