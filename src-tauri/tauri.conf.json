{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniGate",
  "version": "../package.json",
  "identifier": "com.unigate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UniGate",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": 800,
        "maxHeight": 600,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TblP",
    "homepage": "https://github.com/TblP/UniGate",
    "copyright": "Copyright © 2026 TblP",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "VPN, proxy and tunnel client with a single interface",
    "longDescription": "UniGate is an open-source client for self-hosted VPN, proxy and tunnel connections. It manages profiles for Hysteria 2, VLESS, VMess, Trojan, Shadowsocks, TUIC, SOCKS5, HTTP and AmneziaWG, supports proxy and TUN modes, per-app and per-region split tunneling, and live traffic statistics. No telemetry.",
    "externalBin": [
      "binaries/sing-box"
    ],
    "resources": {
      "binaries/geoip-ru.srs": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
